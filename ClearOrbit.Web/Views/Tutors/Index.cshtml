@model List<ClearOrbit.Web.ViewModels.TutorListItem>
@{
    ViewData["Title"] = "Tutors";
    Layout = "_Layout";
}

@section TopbarActions {
    <a href="/Tutors/Create" class="btn-primary" style="padding:10px 22px;font-size:0.9rem;">+ New Tutor</a>
}

@if (TempData["Success"] is string success)
{
    <div style="background:#DCFCE7;border-left:4px solid #16A34A;color:#166534;padding:12px 16px;border-radius:8px;margin-bottom:20px;">
        @success
    </div>
}

<div class="co-card" style="padding:0;overflow:hidden;">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <h3>No tutors yet</h3>
            <p>Add your first Academy instructor.</p>
            <a href="/Tutors/Create" class="btn-primary">Add Tutor</a>
        </div>
    }
    else
    {
        <table class="co-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Specializations</th>
                    <th>Contact</th>
                    <th>Joined</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td style="font-family:monospace;font-size:0.78rem;color:#6B7280;">@t.Code</td>
                        <td style="font-weight:600;">@t.FullName</td>
                        <td>
                            <span class="badge badge-blue">@t.Specializations</span>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(t.Email))
                            {
                                <div style="font-size:0.82rem;">@t.Email</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(t.Phone))
                            {
                                <div style="font-size:0.75rem;color:#6B7280;">@t.Phone</div>
                            }
                        </td>
                        <td>@t.JoinedOn.ToString("yyyy-MM-dd")</td>
                        <td style="text-align:right;">
                            <a href="/Tutors/Edit/@t.Id" style="font-size:0.85rem;">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>