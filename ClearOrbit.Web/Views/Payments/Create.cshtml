@model ClearOrbit.Web.ViewModels.PaymentViewModel
@{
    ViewData["Title"] = "Record Payment";
    Layout = "_Layout";
}

<div class="co-card" style="max-width:640px;">

    <div style="background:var(--co-light);padding:20px;border-radius:12px;margin-bottom:24px;">
        <div style="font-family:monospace;font-size:0.85rem;color:#6B7280;">@Model.InvoiceCode</div>
        <div style="font-size:1.1rem;font-weight:600;margin:4px 0;">@Model.ClientName</div>
        <div style="margin-top:12px;font-size:0.9rem;color:#6B7280;">
            Outstanding balance:
            <span style="color:#DC2626;font-weight:700;">@Model.Currency @(Model.BalanceDue?.ToString("N2") ?? "0.00")</span>
        </div>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="InvoiceId" />
        <input type="hidden" asp-for="InvoiceCode" />
        <input type="hidden" asp-for="ClientName" />
        <input type="hidden" asp-for="BalanceDue" />
        <input type="hidden" asp-for="Currency" />

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            <div class="form-group">
                <label asp-for="Amount">Amount *</label>
                <input asp-for="Amount" type="number" step="0.01" />
                <span asp-validation-for="Amount" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="PaymentDate">Payment Date *</label>
                <input asp-for="PaymentDate" type="date" />
                <span asp-validation-for="PaymentDate" class="field-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Method">Payment Method</label>
            <select asp-for="Method" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);">
                <option value="1">Bank Transfer</option>
                <option value="2">Cash</option>
                <option value="3">Card</option>
                <option value="4">EFT</option>
                <option value="5">Mobile Money</option>
                <option value="99">Other</option>
            </select>
        </div>

        <div class="form-group">
            <label asp-for="Reference">Reference (bank ref, receipt no.)</label>
            <input asp-for="Reference" placeholder="e.g., ABC-2026-09-001" />
        </div>

        <div class="form-group">
            <label asp-for="Notes">Notes</label>
            <textarea asp-for="Notes" rows="3" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);"></textarea>
        </div>

        <div style="display:flex;gap:12px;margin-top:24px;">
            <button type="submit" class="btn-primary">Record Payment</button>
            <a href="/Invoices/Details/@Model.InvoiceId" class="btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}