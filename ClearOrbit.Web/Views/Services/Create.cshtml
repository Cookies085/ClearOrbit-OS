@model ClearOrbit.Web.ViewModels.ServiceViewModel
@{
    ViewData["Title"] = "New Service";
    Layout = "_Layout";
}

<div class="co-card" style="max-width:640px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Name">Service Name *</label>
            <input asp-for="Name" placeholder="e.g., Logo Design" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="DivisionId">Division *</label>
            <select asp-for="DivisionId" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);">
                <option value="">-- Select a division --</option>
                @foreach (var d in Model.Divisions)
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </select>
            <span asp-validation-for="DivisionId" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" rows="3" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);"></textarea>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;">
            <div class="form-group">
                <label asp-for="BasePrice">Base Price</label>
                <input asp-for="BasePrice" type="number" step="0.01" value="0" />
            </div>
            <div class="form-group">
                <label asp-for="Currency">Currency</label>
                <input asp-for="Currency" value="ZAR" />
            </div>
            <div class="form-group">
                <label asp-for="Unit">Unit</label>
                <select asp-for="Unit" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);">
                    <option value="1">Fixed</option>
                    <option value="2">Hourly</option>
                    <option value="3">Monthly</option>
                    <option value="4">Per Session</option>
                </select>
            </div>
        </div>

        <div style="display:flex;gap:12px;margin-top:24px;">
            <button type="submit" class="btn-primary">Create Service</button>
            <a href="/Services" class="btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}