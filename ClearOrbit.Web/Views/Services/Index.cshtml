@model List<ClearOrbit.Web.ViewModels.ServiceListItem>
@{
    ViewData["Title"] = "Services";
    Layout = "_Layout";
}

@section TopbarActions {
    <a href="/Services/Create" class="btn-primary" style="padding:10px 22px;font-size:0.9rem;">+ New Service</a>
}

@if (TempData["Success"] is string success)
{
    <div style="background:#DCFCE7;border-left:4px solid #16A34A;color:#166534;padding:12px 16px;border-radius:8px;margin-bottom:20px;">
        @success
    </div>
}

<div class="co-card" style="padding:0;overflow:hidden;">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <h3>No services yet</h3>
            <p>Define what ClearOrbit provides — starting with Academy or Software.</p>
            <a href="/Services/Create" class="btn-primary">Create Service</a>
        </div>
    }
    else
    {
        <table class="co-table">
            <thead>
                <tr>
                    <th>Service</th>
                    <th>Division</th>
                    <th>Unit</th>
                    <th>Price</th>
                    <th>Added</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>
                            <div style="font-weight:600;">@s.Name</div>
                            @if (!string.IsNullOrWhiteSpace(s.Description))
                            {
                                <div style="color:#6B7280;font-size:0.8rem;">@s.Description</div>
                            }
                        </td>
                        <td>
                            <span class="badge" style="background:@(s.DivisionAccent)22;color:@s.DivisionAccent;">
                                @s.DivisionName
                            </span>
                        </td>
                        <td>@s.UnitName</td>
                        <td style="font-weight:600;">@s.Currency @s.BasePrice.ToString("N2")</td>
                        <td>@s.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td style="text-align:right;">
                            <a href="/Services/Edit/@s.Id" style="font-size:0.85rem;">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>