@model ClearOrbit.Web.ViewModels.RecordResultsViewModel
@{
    ViewData["Title"] = "Record Results";
    Layout = "_Layout";
}

@if (TempData["Error"] is string err)
{
    <div style="background:#FEE2E2;border-left:4px solid #DC2626;color:#991B1B;padding:12px 16px;border-radius:8px;margin-bottom:20px;">@err</div>
}

<div class="co-card">
    <div style="margin-bottom:24px;">
        <div style="font-family:monospace;font-size:0.8rem;color:#6B7280;">@Model.AssessmentCode</div>
        <h2 style="margin:2px 0 4px;font-size:1.35rem;">@Model.AssessmentTitle</h2>
        <div style="color:#6B7280;font-size:0.85rem;">@Model.ClassCode — @Model.ClassName · Max Score: @Model.MaxScore.ToString("N0")</div>
    </div>

    @if (Model.Rows.Count == 0)
    {
        <div class="empty-state">
            <h3>No active enrollments</h3>
            <p>Enroll learners in the class before recording results.</p>
            <a href="/Assessments" class="btn-primary">Back to Assessments</a>
        </div>
    }
    else
    {
        <form asp-action="Record" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="AssessmentId" />
            <input type="hidden" asp-for="AssessmentCode" />
            <input type="hidden" asp-for="AssessmentTitle" />
            <input type="hidden" asp-for="ClassCode" />
            <input type="hidden" asp-for="ClassName" />
            <input type="hidden" asp-for="MaxScore" />

            <table class="co-table">
                <thead>
                    <tr>
                        <th>Learner</th>
                        <th>Code</th>
                        <th style="width:160px;">Score (out of @Model.MaxScore.ToString("N0"))</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Rows.Count; i++)
                    {
                        var row = Model.Rows[i];
                        <tr>
                            <td>
                                <input type="hidden" asp-for="Rows[i].LearnerId" />
                                <input type="hidden" asp-for="Rows[i].LearnerCode" />
                                <input type="hidden" asp-for="Rows[i].LearnerName" />
                                <div style="font-weight:600;">@row.LearnerName</div>
                            </td>
                            <td style="font-family:monospace;font-size:0.78rem;color:#6B7280;">@row.LearnerCode</td>
                            <td>
                                <input asp-for="Rows[i].Score" type="number" step="0.01" min="0" max="@Model.MaxScore"
                                       placeholder="—"
                                       style="width:100%;padding:10px 14px;border:1.5px solid #E5E7EB;border-radius:8px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);" />
                            </td>
                            <td>
                                <input asp-for="Rows[i].Notes" placeholder="Optional"
                                       style="width:100%;padding:10px 14px;border:1.5px solid #E5E7EB;border-radius:8px;font-family:var(--co-font);font-size:0.85rem;background:var(--co-gray-50);" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div style="display:flex;gap:12px;margin-top:24px;">
                <button type="submit" class="btn-primary">Save Results</button>
                <a href="/Assessments" class="btn-outline">Cancel</a>
            </div>
        </form>
    }
</div>