@model ClearOrbit.Web.ViewModels.AssessmentViewModel
@{
    ViewData["Title"] = "Edit Assessment";
    Layout = "_Layout";
}

<div class="co-card" style="max-width:720px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label>Class</label>
            <input type="text" value="@Model.ClassCode — @Model.ClassName" disabled
                   style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-100);color:#6B7280;" />
            <input type="hidden" asp-for="ClassId" />
        </div>

        <div class="form-group">
            <label asp-for="Status">Status *</label>
            <select asp-for="Status" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);">
                <option value="1">Draft</option>
                <option value="2">Scheduled</option>
                <option value="3">Completed</option>
                <option value="4">Cancelled</option>
            </select>
        </div>

        <div class="form-group">
            <label asp-for="Title">Assessment Title *</label>
            <input asp-for="Title" />
            <span asp-validation-for="Title" class="field-error"></span>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="form-group">
                <label asp-for="Type">Type</label>
                <select asp-for="Type" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);">
                    <option value="1">Quiz</option>
                    <option value="2">Test</option>
                    <option value="3">Exam</option>
                    <option value="4">Assignment</option>
                    <option value="5">Project</option>
                    <option value="6">Practical</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="ScheduledDate">Scheduled Date</label>
                <input asp-for="ScheduledDate" type="date" />
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="form-group">
                <label asp-for="MaxScore">Maximum Score</label>
                <input asp-for="MaxScore" type="number" step="0.01" />
                <span asp-validation-for="MaxScore" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Weight">Weight (%)</label>
                <input asp-for="Weight" type="number" step="0.01" />
                <span asp-validation-for="Weight" class="field-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" rows="3" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);"></textarea>
        </div>

        <div style="display:flex;gap:12px;margin-top:24px;">
            <button type="submit" class="btn-primary">Save Changes</button>
            <a href="/Assessments" class="btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}