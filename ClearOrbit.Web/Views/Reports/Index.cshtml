@model ClearOrbit.Web.ViewModels.ReportsIndexViewModel
@{
    ViewData["Title"] = "Reports";
    Layout = "_Layout";

    var s = Model.Summary;
    var profitColor = s.NetProfit >= 0 ? "#16A34A" : "#DC2626";
    var marginColor = s.ProfitMargin >= 20 ? "#16A34A"
        : s.ProfitMargin >= 0 ? "#F59E0B" : "#DC2626";

    var maxDivisionRevenue = Model.Divisions.Any()
        ? Math.Max(Model.Divisions.Max(d => d.Revenue), 1)
        : 1;
}

<!-- =========================
     HERO
     ========================= -->
<div class="division-hero">
    <div class="division-hero-inner">
        <div class="division-hero-header">
            <div class="division-hero-icon" style="background: linear-gradient(135deg, #1E90FF, #004FFF);">📊</div>
            <div>
                <div class="division-hero-eyebrow">Business Intelligence</div>
                <h2 class="division-hero-title">Reports</h2>
            </div>
        </div>

        <p class="division-hero-tagline">
            Profitability, receivables, and performance across the entire group.
        </p>

        <div class="division-hero-stats" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
            <div>
                <div class="division-hero-stat-label">Invoiced (all time)</div>
                <div class="division-hero-stat-value">@s.Currency @s.TotalInvoiced.ToString("N0")</div>
            </div>
            <div>
                <div class="division-hero-stat-label">Revenue Collected</div>
                <div class="division-hero-stat-value" style="color:#7FE9A5;">@s.Currency @s.TotalRevenue.ToString("N0")</div>
            </div>
            <div>
                <div class="division-hero-stat-label">Net Profit</div>
                <div class="division-hero-stat-value" style="color:@(s.NetProfit >= 0 ? "#7FE9A5" : "#FCA5A5");">
                    @s.Currency @s.NetProfit.ToString("N0")
                </div>
            </div>
            <div>
                <div class="division-hero-stat-label">Margin</div>
                <div class="division-hero-stat-value">@s.ProfitMargin.ToString("F1")%</div>
            </div>
            <div>
                <div class="division-hero-stat-label">Outstanding</div>
                <div class="division-hero-stat-value" style="color:@(s.OutstandingReceivables > 0 ? "#FCD34D" : "#7FE9A5");">
                    @s.Currency @s.OutstandingReceivables.ToString("N0")
                </div>
            </div>
            <div>
                <div class="division-hero-stat-label">Overdue</div>
                <div class="division-hero-stat-value" style="color:@(s.OverdueReceivables > 0 ? "#FCA5A5" : "#fff");">
                    @s.Currency @s.OverdueReceivables.ToString("N0")
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =========================
     KPI CARDS
     ========================= -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;margin-bottom:28px;">

    <div class="stat-card">
        <div class="stat-label">Net Profit</div>
        <div class="stat-value" style="color:@profitColor;">@s.Currency @s.NetProfit.ToString("N0")</div>
        <div class="stat-sub">Revenue − Expenses</div>
    </div>

    <div class="stat-card">
        <div class="stat-label">Profit Margin</div>
        <div class="stat-value" style="color:@marginColor;">@s.ProfitMargin.ToString("F1")%</div>
        <div class="stat-sub">Profit ÷ Revenue</div>
    </div>

    <div class="stat-card">
        <div class="stat-label">Invoices Paid</div>
        <div class="stat-value" style="color:#16A34A;">@s.PaidInvoiceCount</div>
        <div class="stat-sub">@s.UnpaidInvoiceCount outstanding</div>
    </div>

    <div class="stat-card">
        <div class="stat-label">Overdue Invoices</div>
        <div class="stat-value" style="color:@(s.OverdueInvoiceCount > 0 ? "#DC2626" : "#16A34A");">@s.OverdueInvoiceCount</div>
        <div class="stat-sub">@s.TotalClients clients · @s.TotalProjects projects</div>
    </div>

</div>

<!-- =========================
     DIVISION PROFITABILITY
     ========================= -->
<div class="co-card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
        <div>
            <h3 class="co-card-title" style="margin:0;">Division Profitability</h3>
            <p style="color:#6B7280;font-size:0.85rem;margin:4px 0 0;">
                How each of the eight divisions performs.
            </p>
        </div>
    </div>

    @if (Model.Divisions.Count == 0)
    {
        <p style="color:#6B7280;margin:0;font-size:0.9rem;">No data yet.</p>
    }
    else
    {
        <div style="display:flex;flex-direction:column;gap:20px;">
            @foreach (var d in Model.Divisions)
            {
                var barWidth = (double)d.Revenue / (double)maxDivisionRevenue * 100;
                var marginCol = d.ProfitMargin >= 20 ? "#16A34A"
                : d.ProfitMargin >= 0 ? "#F59E0B"
                : "#DC2626";

                <div>
                    <div style="display:flex;justify-content:space-between;align-items:end;margin-bottom:8px;gap:16px;flex-wrap:wrap;">
                        <div style="display:flex;align-items:center;gap:10px;">
                            <span style="width:10px;height:10px;border-radius:50%;background:@d.AccentColor;box-shadow:0 0 8px @(d.AccentColor)66;"></span>
                            <span style="font-weight:600;color:var(--co-deep);font-size:0.95rem;">@d.DivisionName</span>
                            <span style="font-size:0.75rem;color:#9CA3AF;">@d.ProjectCount project@(d.ProjectCount == 1 ? "" : "s")</span>
                        </div>

                        <div style="display:flex;gap:24px;font-size:0.82rem;color:#6B7280;">
                            <div>
                                <span style="color:#9CA3AF;">Invoiced</span>
                                <span style="font-weight:600;color:var(--co-deep);margin-left:6px;">@s.Currency @d.Invoiced.ToString("N0")</span>
                            </div>
                            <div>
                                <span style="color:#9CA3AF;">Expenses</span>
                                <span style="font-weight:600;color:#DC2626;margin-left:6px;">@s.Currency @d.Expenses.ToString("N0")</span>
                            </div>
                            <div>
                                <span style="color:#9CA3AF;">Net</span>
                                <span style="font-weight:700;color:@(d.NetProfit >= 0 ? "#16A34A" : "#DC2626");margin-left:6px;">
                                    @s.Currency @d.NetProfit.ToString("N0")
                                </span>
                            </div>
                            <div style="min-width:70px;text-align:right;">
                                <span style="font-weight:700;color:@marginCol;">@d.ProfitMargin.ToString("F1")%</span>
                            </div>
                        </div>
                    </div>
                    <div style="height:8px;background:var(--co-light);border-radius:999px;overflow:hidden;position:relative;">
                        <div style="height:100%;width:@barWidth.ToString("F1")%;background:linear-gradient(90deg, @d.AccentColor 0%, @(d.AccentColor)99 100%);border-radius:999px;transition:width 0.6s;"></div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- =========================
     CLIENT PROFITABILITY
     ========================= -->
<div class="co-card" style="padding:0;overflow:hidden;">
    <div style="padding:24px 24px 16px;">
        <h3 class="co-card-title" style="margin:0;">Client Profitability</h3>
        <p style="color:#6B7280;font-size:0.85rem;margin:4px 0 0;">
            Who pays on time, who owes, and who owes for how long.
        </p>
    </div>

    @if (Model.Clients.Count == 0)
    {
        <p style="color:#6B7280;margin:0;padding:0 24px 24px;font-size:0.9rem;">No clients yet.</p>
    }
    else
    {
        <table class="co-table">
            <thead>
                <tr>
                    <th>Client</th>
                    <th style="text-align:center;">Projects</th>
                    <th style="text-align:center;">Invoices</th>
                    <th style="text-align:right;">Invoiced</th>
                    <th style="text-align:right;">Paid</th>
                    <th style="text-align:right;">Outstanding</th>
                    <th style="text-align:right;">Overdue</th>
                    <th style="text-align:right;">Aging</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Clients)
                {
                    <tr>
                        <td style="font-weight:600;">@c.ClientName</td>
                        <td style="text-align:center;">@c.ProjectCount</td>
                        <td style="text-align:center;">@c.InvoiceCount</td>
                        <td style="text-align:right;">@s.Currency @c.Invoiced.ToString("N0")</td>
                        <td style="text-align:right;color:#16A34A;font-weight:600;">@s.Currency @c.Paid.ToString("N0")</td>
                        <td style="text-align:right;color:@(c.Outstanding > 0 ? "#F59E0B" : "#6B7280");font-weight:600;">
                            @s.Currency @c.Outstanding.ToString("N0")
                        </td>
                        <td style="text-align:right;color:@(c.Overdue > 0 ? "#DC2626" : "#6B7280");font-weight:600;">
                            @s.Currency @c.Overdue.ToString("N0")
                        </td>
                        <td style="text-align:right;">
                            @if (c.DaysOutstanding > 0)
                            {
                                var ageColor = c.DaysOutstanding > 60 ? "#DC2626"
                                : c.DaysOutstanding > 30 ? "#F59E0B"
                                : "#6B7280";
                                <span class="badge" style="background:@(ageColor)22;color:@ageColor;">
                                    @c.DaysOutstanding day@(c.DaysOutstanding == 1 ? "" : "s")
                                </span>
                            }
                            else
                            {
                                <span style="color:#16A34A;font-size:0.82rem;">Clear</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- =========================
     PROJECT PROFITABILITY
     ========================= -->
<div class="co-card" style="padding:0;overflow:hidden;">
    <div style="padding:24px 24px 16px;">
        <h3 class="co-card-title" style="margin:0;">Project Profitability</h3>
        <p style="color:#6B7280;font-size:0.85rem;margin:4px 0 0;">
            Every project, ranked by what it actually earned.
        </p>
    </div>

    @if (Model.Projects.Count == 0)
    {
        <p style="color:#6B7280;margin:0;padding:0 24px 24px;font-size:0.9rem;">No projects yet.</p>
    }
    else
    {
        <table class="co-table">
            <thead>
                <tr>
                    <th>Project</th>
                    <th>Division</th>
                    <th>Client</th>
                    <th style="text-align:right;">Invoiced</th>
                    <th style="text-align:right;">Paid</th>
                    <th style="text-align:right;">Expenses</th>
                    <th style="text-align:right;">Net</th>
                    <th style="text-align:right;">Margin</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Projects)
                {
                    var marginCol = p.ProfitMargin >= 20 ? "#16A34A"
                    : p.ProfitMargin >= 0 ? "#F59E0B"
                    : "#DC2626";

                    <tr>
                        <td>
                            <a href="/Projects/Edit/@p.ProjectId" style="font-weight:600;color:var(--co-deep);">@p.Name</a>
                            <div style="font-family:monospace;font-size:0.72rem;color:#6B7280;">@p.Code</div>
                        </td>
                        <td>
                            <span class="badge" style="background:@(p.DivisionAccent)22;color:@p.DivisionAccent;">
                                @p.DivisionName
                            </span>
                        </td>
                        <td>@(p.ClientName ?? "—")</td>
                        <td style="text-align:right;">@p.Currency @p.Invoiced.ToString("N0")</td>
                        <td style="text-align:right;color:#16A34A;font-weight:600;">@p.Currency @p.Paid.ToString("N0")</td>
                        <td style="text-align:right;color:#DC2626;">@p.Currency @p.Expenses.ToString("N0")</td>
                        <td style="text-align:right;font-weight:700;color:@(p.NetProfit >= 0 ? "#16A34A" : "#DC2626");">
                            @p.Currency @p.NetProfit.ToString("N0")
                        </td>
                        <td style="text-align:right;font-weight:600;color:@marginCol;">@p.ProfitMargin.ToString("F1")%</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>