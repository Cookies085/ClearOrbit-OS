@model ClearOrbit.Web.ViewModels.InvoiceViewModel
@{
    ViewData["Title"] = "New Invoice";
    Layout = "_Layout";
}

<div class="co-card" style="max-width:900px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            <div class="form-group">
                <label asp-for="ClientId">Client *</label>
                <select asp-for="ClientId" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);">
                    <option value="">-- Select a client --</option>
                    @foreach (var c in Model.Clients)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
                <span asp-validation-for="ClientId" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="DivisionId">Issuing Division *</label>
                <select asp-for="DivisionId" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);">
                    <option value="">-- Select a division --</option>
                    @foreach (var d in Model.Divisions)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
                <span asp-validation-for="DivisionId" class="field-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="ProjectId">Project (optional)</label>
            <select asp-for="ProjectId" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);">
                <option value="">-- No project --</option>
                @foreach (var p in Model.Projects)
                {
                    <option value="@p.Id">@p.Code — @p.Name (@p.DivisionName)</option>
                }
            </select>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:12px;">
            <div class="form-group">
                <label asp-for="IssueDate">Issue Date</label>
                <input asp-for="IssueDate" type="date" />
            </div>
            <div class="form-group">
                <label asp-for="DueDate">Due Date</label>
                <input asp-for="DueDate" type="date" />
            </div>
            <div class="form-group">
                <label asp-for="Currency">Currency</label>
                <input asp-for="Currency" />
            </div>
            <div class="form-group">
                <label asp-for="TaxRate">Tax Rate %</label>
                <input asp-for="TaxRate" type="number" step="0.01" />
            </div>
        </div>

        <h3 style="margin-top:32px;margin-bottom:16px;font-size:1rem;">Line Items</h3>

        <div id="itemsContainer">
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <div class="item-row" style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr auto;gap:8px;margin-bottom:8px;align-items:end;">
                    <div class="form-group" style="margin-bottom:0;">
                        <input name="Items[@i].Description" value="@Model.Items[i].Description" placeholder="Description" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <input name="Items[@i].Quantity" type="number" step="0.01" value="@Model.Items[i].Quantity" placeholder="Qty" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);" />
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <input name="Items[@i].UnitPrice" type="number" step="0.01" value="@Model.Items[i].UnitPrice" placeholder="Unit Price" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);" />
                    </div>
                    <div style="padding:13px 8px;color:#6B7280;font-size:0.85rem;">Line Total</div>
                    <button type="button" onclick="removeRow(this)" style="background:#FEE2E2;color:#DC2626;border:none;border-radius:10px;width:40px;height:44px;cursor:pointer;font-weight:600;">×</button>
                </div>
            }
        </div>

        <button type="button" onclick="addRow()" class="btn-outline" style="margin-top:8px;">+ Add Item</button>

        <div class="form-group" style="margin-top:24px;">
            <label asp-for="Notes">Notes</label>
            <textarea asp-for="Notes" rows="3" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);"></textarea>
        </div>

        <div style="display:flex;gap:12px;margin-top:24px;">
            <button type="submit" class="btn-primary">Create Invoice</button>
            <a href="/Invoices" class="btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function addRow() {
            const container = document.getElementById('itemsContainer');
            const idx = container.querySelectorAll('.item-row').length;
            const div = document.createElement('div');
            div.className = 'item-row';
            div.style.cssText = 'display:grid;grid-template-columns:2fr 1fr 1fr 1fr auto;gap:8px;margin-bottom:8px;align-items:end;';
            div.innerHTML = `
                <div style="margin-bottom:0;">
                    <input name="Items[${idx}].Description" placeholder="Description" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);" />
                </div>
                <div style="margin-bottom:0;">
                    <input name="Items[${idx}].Quantity" type="number" step="0.01" value="1" placeholder="Qty" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);" />
                </div>
                <div style="margin-bottom:0;">
                    <input name="Items[${idx}].UnitPrice" type="number" step="0.01" value="0" placeholder="Unit Price" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);" />
                </div>
                <div style="padding:13px 8px;color:#6B7280;font-size:0.85rem;">Line Total</div>
                <button type="button" onclick="removeRow(this)" style="background:#FEE2E2;color:#DC2626;border:none;border-radius:10px;width:40px;height:44px;cursor:pointer;font-weight:600;">×</button>
            `;
            container.appendChild(div);
        }
        function removeRow(btn) {
            const rows = document.querySelectorAll('.item-row');
            if (rows.length > 1) btn.closest('.item-row').remove();
        }
    </script>
}