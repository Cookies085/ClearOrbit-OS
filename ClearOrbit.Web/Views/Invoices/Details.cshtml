@model ClearOrbit.Web.ViewModels.InvoiceListItem
@{
    ViewData["Title"] = Model.Code;
    Layout = "_Layout";
}

@section TopbarActions {
    @if (Model.StatusName == "Draft")
    {
        <form asp-action="Send" asp-route-id="@Model.Id" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-primary" style="padding:10px 22px;font-size:0.9rem;">Mark as Sent</button>
        </form>
    }
    @if (Model.StatusName != "Cancelled" && Model.StatusName != "Paid")
    {
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" style="display:inline;margin-left:8px;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-outline" style="padding:10px 22px;font-size:0.9rem;">Cancel Invoice</button>
        </form>
    }
}

@if (TempData["Success"] is string success)
{
    <div style="background:#DCFCE7;border-left:4px solid #16A34A;color:#166534;padding:12px 16px;border-radius:8px;margin-bottom:20px;">
        @success
    </div>
}

<div class="co-card">
    <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:24px;">
        <div>
            <div style="font-family:monospace;font-size:1.5rem;font-weight:700;color:var(--co-deep);">@Model.Code</div>
            <div style="color:#6B7280;font-size:0.9rem;">Issued @Model.IssueDate.ToString("dd MMM yyyy")</div>
        </div>
        <div style="text-align:right;">
            @{
                var statusColor = Model.StatusName switch
                {
                    "Draft" => "#6B7280",
                    "Sent" => "#3B82F6",
                    "PartiallyPaid" => "#F59E0B",
                    "Paid" => "#16A34A",
                    "Cancelled" => "#9CA3AF",
                    _ => "#6B7280"
                };
            }
            <span class="badge" style="background:@(statusColor)22;color:@statusColor;font-size:0.85rem;padding:6px 16px;">@Model.StatusName</span>
            @if (Model.IsOverdue)
            {
                <div style="margin-top:8px;"><span class="badge" style="background:#FEE2E2;color:#DC2626;">OVERDUE</span></div>
            }
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:24px;padding:20px 0;border-top:1px solid #E5E7EB;border-bottom:1px solid #E5E7EB;">
        <div>
            <div style="font-size:0.7rem;letter-spacing:2px;color:#6B7280;font-weight:600;margin-bottom:6px;">BILL TO</div>
            <div style="font-weight:600;">@Model.ClientName</div>
        </div>
        <div>
            <div style="font-size:0.7rem;letter-spacing:2px;color:#6B7280;font-weight:600;margin-bottom:6px;">DIVISION</div>
            <span class="badge" style="background:@(Model.DivisionAccent)22;color:@Model.DivisionAccent;">@Model.DivisionName</span>
        </div>
        <div>
            <div style="font-size:0.7rem;letter-spacing:2px;color:#6B7280;font-weight:600;margin-bottom:6px;">DUE DATE</div>
            <div style="font-weight:600;">@Model.DueDate.ToString("dd MMM yyyy")</div>
        </div>
    </div>

    <table class="co-table" style="margin-top:20px;">
        <thead>
            <tr>
                <th>Description</th>
                <th style="text-align:right;">Qty</th>
                <th style="text-align:right;">Unit Price</th>
                <th style="text-align:right;">Line Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Description</td>
                    <td style="text-align:right;">@item.Quantity</td>
                    <td style="text-align:right;">@Model.Currency @item.UnitPrice.ToString("N2")</td>
                    <td style="text-align:right;font-weight:600;">@Model.Currency @item.LineTotal.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div style="display:flex;justify-content:flex-end;margin-top:24px;">
        <div style="min-width:280px;">
            <div style="display:flex;justify-content:space-between;padding:6px 0;">
                <span style="color:#6B7280;">Subtotal</span>
                <span>@Model.Currency @Model.SubTotal.ToString("N2")</span>
            </div>
            @if (Model.TaxRate > 0)
            {
                <div style="display:flex;justify-content:space-between;padding:6px 0;">
                    <span style="color:#6B7280;">Tax (@Model.TaxRate%)</span>
                    <span>@Model.Currency @Model.TaxAmount.ToString("N2")</span>
                </div>
            }
            <div style="display:flex;justify-content:space-between;padding:12px 0;border-top:2px solid var(--co-deep);margin-top:8px;font-weight:700;font-size:1.15rem;">
                <span>Total</span>
                <span>@Model.Currency @Model.Total.ToString("N2")</span>
            </div>
            @if (Model.AmountPaid > 0)
            {
                <div style="display:flex;justify-content:space-between;padding:6px 0;color:#16A34A;">
                    <span>Paid</span>
                    <span>@Model.Currency @Model.AmountPaid.ToString("N2")</span>
                </div>
                <div style="display:flex;justify-content:space-between;padding:8px 0;font-weight:600;color:@(Model.BalanceDue > 0 ? "#DC2626" : "#16A34A");">
                    <span>Balance Due</span>
                    <span>@Model.Currency @Model.BalanceDue.ToString("N2")</span>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div style="margin-top:32px;padding-top:20px;border-top:1px solid #E5E7EB;">
            <div style="font-size:0.7rem;letter-spacing:2px;color:#6B7280;font-weight:600;margin-bottom:8px;">NOTES</div>
            <div style="color:#374151;font-size:0.9rem;white-space:pre-wrap;">@Model.Notes</div>
        </div>
    }
</div>

@{
    var paymentsResponse = ViewData["Payments"] as List<ClearOrbit.Web.ViewModels.PaymentListItem> ?? new();
}

<div class="co-card" style="margin-top:24px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <h3 class="co-card-title" style="margin:0;">Payments</h3>
        @if (Model.StatusName != "Paid" && Model.StatusName != "Cancelled" && Model.BalanceDue > 0)
        {
            <a href="/Payments/Create?invoiceId=@Model.Id" class="btn-primary" style="padding:8px 18px;font-size:0.85rem;">+ Record Payment</a>
        }
    </div>

    @if (paymentsResponse.Count == 0)
    {
        <p style="color:#6B7280;margin:0;font-size:0.9rem;">No payments recorded yet.</p>
    }
    else
    {
        <table class="co-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Date</th>
                    <th>Method</th>
                    <th>Reference</th>
                    <th style="text-align:right;">Amount</th>
                    <th style="text-align:right;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in paymentsResponse)
                {
                    <tr>
                        <td style="font-family:monospace;font-size:0.8rem;">@p.Code</td>
                        <td>@p.PaymentDate.ToString("yyyy-MM-dd")</td>
                        <td>@p.MethodName</td>
                        <td>@(p.Reference ?? "—")</td>
                        <td style="text-align:right;font-weight:600;color:#16A34A;">@p.Currency @p.Amount.ToString("N2")</td>
                        <td style="text-align:right;">
                            <form asp-controller="Payments" asp-action="Delete" method="post" style="margin:0;display:inline;" onsubmit="return confirm('Reverse this payment?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@p.Id" />
                                <input type="hidden" name="invoiceId" value="@Model.Id" />
                                <button type="submit" style="background:none;border:none;color:#DC2626;font-size:0.8rem;cursor:pointer;">Reverse</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<a href="/Invoices" style="font-size:0.9rem;">← Back to Invoices</a>