@model List<ClearOrbit.Web.ViewModels.ClientListItem>
@{
    ViewData["Title"] = "Clients";
    Layout = "_Layout";
}

@section TopbarActions {
    <a href="/Clients/Create" class="btn-primary" style="padding:10px 22px;font-size:0.9rem;">+ New Client</a>
}

@if (TempData["Success"] is string success)
{
    <div style="background:#DCFCE7;border-left:4px solid #16A34A;color:#166534;padding:12px 16px;border-radius:8px;margin-bottom:20px;">
        @success
    </div>
}

<div class="co-card" style="padding:0;overflow:hidden;">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <h3>No clients yet</h3>
            <p>Add your first client to get started.</p>
            <a href="/Clients/Create" class="btn-primary">Create Client</a>
        </div>
    }
    else
    {
        <table class="co-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Industry</th>
                    <th>Website</th>
                    <th>Contacts</th>
                    <th>Added</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td style="font-weight:600;">@c.Name</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(c.Industry))
                            {
                                <span class="badge badge-blue">@c.Industry</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(c.Website))
                            {
                                <a href="@c.Website" target="_blank" rel="noopener">@c.Website</a>
                            }
                        </td>
                        <td>@c.ContactCount</td>
                        <td>@c.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td style="text-align:right;">
                            <a href="/Clients/Edit/@c.Id" style="font-size:0.85rem;">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>