@model ClearOrbit.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_LoginLayout";
}

<nav class="co-auth-nav">
    <a href="/" class="co-auth-nav-brand">
        <img src="~/img/logo-dark.png" alt="ClearOrbit" />
        <span>CLEARORBIT</span>
    </a>
    <a href="/" class="co-auth-nav-back">← Back to site</a>
</nav>

<div class="co-auth-page">
    <div class="co-auth-orbit"></div>

    <div class="co-auth-card">
        <div class="co-auth-logo">
            <img src="~/img/logo-dark.png" alt="ClearOrbit Group" />
        </div>

        <h1 class="co-auth-title">Welcome back</h1>
        <p class="co-auth-subtitle">Sign in to ClearOrbit OS</p>

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div asp-validation-summary="ModelOnly" class="co-auth-error"></div>

            <div class="co-auth-field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" autocomplete="username" placeholder="you@clearorbit.co.za" />
                <span asp-validation-for="Email" class="co-auth-field-error"></span>
            </div>

            <div class="co-auth-field">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" autocomplete="current-password" placeholder="••••••••" />
                <span asp-validation-for="Password" class="co-auth-field-error"></span>
            </div>

            <label class="co-auth-remember">
                <input asp-for="RememberMe" type="checkbox" />
                <span>Keep me signed in</span>
            </label>

            <button type="submit" class="co-auth-btn">Sign In →</button>
        </form>

        <div class="co-auth-footer">
            <a href="/">← Return to clearorbit.co.za</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}