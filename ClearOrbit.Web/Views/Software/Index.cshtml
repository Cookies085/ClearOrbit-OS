@model ClearOrbit.Web.ViewModels.SoftwareWorkspaceViewModel
@{
    ViewData["Title"] = "Software";
    Layout = "_Layout";
}

<div class="division-hero" style="--hero-accent: #00B4D8; --hero-accent-soft: rgba(0, 180, 216, 0.28); --hero-accent-glow: rgba(0, 180, 216, 0.5);">
    <div class="division-hero-inner">
        <div class="division-hero-header">
            <div class="division-hero-icon">⌨</div>
            <div>
                <div class="division-hero-eyebrow">ClearOrbit</div>
                <h2 class="division-hero-title">Software</h2>
            </div>
        </div>

        <p class="division-hero-tagline">
            Ideas. Code. Solutions.
        </p>

        <div class="division-hero-stats">
            <div>
                <div class="division-hero-stat-label">Total Features</div>
                <div class="division-hero-stat-value">@Model.TotalFeatures</div>
            </div>
            <div>
                <div class="division-hero-stat-label">In Progress</div>
                <div class="division-hero-stat-value">@Model.InProgressFeatures</div>
            </div>
            <div>
                <div class="division-hero-stat-label">Shipped</div>
                <div class="division-hero-stat-value" style="color:#7FE9A5;">@Model.ShippedFeatures</div>
            </div>
            <div>
                <div class="division-hero-stat-label">Critical</div>
                <div class="division-hero-stat-value" style="color:@(Model.CriticalFeatures > 0 ? "#FCA5A5" : "#fff");">@Model.CriticalFeatures</div>
            </div>
            <div>
                <div class="division-hero-stat-label">Open Bugs</div>
                <div class="division-hero-stat-value" style="color:@(Model.OpenBugs > 0 ? "#FCD34D" : "#fff");">@Model.OpenBugs</div>
            </div>
        </div>
    </div>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;margin-bottom:24px;">

    <a href="/Features" style="text-decoration:none;">
        <div class="stat-card" style="cursor:pointer;">
            <div class="stat-label">Features</div>
            <div class="stat-value" style="color:var(--co-deep);">@Model.TotalFeatures</div>
            <div class="stat-sub">@Model.InProgressFeatures in progress · @Model.ShippedFeatures shipped</div>
        </div>
    </a>

    <a href="/Bugs" style="text-decoration:none;">
        <div class="stat-card" style="cursor:pointer;">
            <div class="stat-label">Bugs</div>
            <div class="stat-value" style="color:@(Model.OpenBugs > 0 ? "#F59E0B" : "var(--co-deep)");">@Model.TotalBugs</div>
            <div class="stat-sub">@Model.OpenBugs open · @Model.CriticalBugs critical</div>
        </div>
    </a>

    <a href="/Releases" style="text-decoration:none;">
        <div class="stat-card" style="cursor:pointer;">
            <div class="stat-label">Releases</div>
            <div class="stat-value" style="color:var(--co-deep);">@Model.TotalReleases</div>
            <div class="stat-sub">@Model.ReleasedCount shipped</div>
        </div>
    </a>

    <div>
    <div class="division-hero-stat-label">Releases</div>
    <div class="division-hero-stat-value">@Model.TotalReleases</div>
</div>

</div>

<!-- Recent Features -->
<div class="co-card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <h3 class="co-card-title" style="margin:0;">Recent Features</h3>
        <a href="/Features" style="font-size:0.82rem;">View all →</a>
    </div>
    @if (Model.RecentFeatures.Count == 0)
    {
        <div style="text-align:center;padding:24px 0;color:#9CA3AF;">
            <p style="margin:0 0 16px;">No features yet.</p>
            <a href="/Features/Create" class="btn-primary">Add first feature</a>
        </div>
    }
    else
    {
        <div style="display:flex;flex-direction:column;gap:10px;">
            @foreach (var f in Model.RecentFeatures)
            {
                var statusColor = f.StatusName switch
                {
                    "Proposed" => "#6B7280",
                    "Approved" => "#3B82F6",
                    "InProgress" => "#8B5CF6",
                    "Testing" => "#F59E0B",
                    "Shipped" => "#16A34A",
                    "Rejected" => "#9CA3AF",
                    _ => "#6B7280"
                };
                <a href="/Features/Details/@f.Id" style="display:block;padding:14px 16px;border-radius:12px;background:var(--co-light);text-decoration:none;">
                    <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
                        <div style="min-width:0;">
                            <div style="font-family:monospace;font-size:0.7rem;color:#6B7280;">@f.Code</div>
                            <div style="font-weight:600;color:var(--co-deep);font-size:0.9rem;">@f.Title</div>
                            <div style="font-size:0.75rem;color:#6B7280;margin-top:2px;">
                                @f.DivisionName
                                @if (!string.IsNullOrWhiteSpace(f.ClientName))
                                {
                                    <span> · @f.ClientName</span>
                                }
                            </div>
                        </div>
                        <span class="badge" style="background:@(statusColor)22;color:@statusColor;flex-shrink:0;">@f.StatusName</span>
                    </div>
                </a>
            }
        </div>
    }
</div>

<!-- Recent Bugs -->
<div class="co-card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <h3 class="co-card-title" style="margin:0;">Recent Bugs</h3>
        <a href="/Bugs" style="font-size:0.82rem;">View all →</a>
    </div>
    @if (Model.RecentBugs.Count == 0)
    {
        <p style="color:#6B7280;margin:0;font-size:0.9rem;">No bugs reported. Everything's working.</p>
    }
    else
    {
        <div style="display:flex;flex-direction:column;gap:10px;">
            @foreach (var b in Model.RecentBugs)
            {
                var statusColor = b.StatusName switch
                {
                    "Open" => "#DC2626",
                    "InProgress" => "#F59E0B",
                    "Fixed" => "#3B82F6",
                    "Verified" => "#16A34A",
                    "Closed" => "#9CA3AF",
                    "WontFix" => "#6B7280",
                    _ => "#6B7280"
                };
                var sevColor = b.SeverityName switch
                {
                    "Trivial" => "#9CA3AF",
                    "Minor" => "#3B82F6",
                    "Major" => "#F59E0B",
                    "Critical" => "#DC2626",
                    "Blocker" => "#7F1D1D",
                    _ => "#6B7280"
                };
                <a href="/Bugs/Edit/@b.Id" style="display:block;padding:14px 16px;border-radius:12px;background:var(--co-light);text-decoration:none;">
                    <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
                        <div style="min-width:0;">
                            <div style="font-family:monospace;font-size:0.7rem;color:#6B7280;">@b.Code</div>
                            <div style="font-weight:600;color:var(--co-deep);font-size:0.9rem;">@b.Title</div>
                            <div style="font-size:0.75rem;color:#6B7280;margin-top:2px;">@b.DivisionName</div>
                        </div>
                        <div style="display:flex;gap:6px;flex-shrink:0;">
                            <span class="badge" style="background:@(sevColor)22;color:@sevColor;">@b.SeverityName</span>
                            <span class="badge" style="background:@(statusColor)22;color:@statusColor;">@b.StatusName</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>

<div class="co-card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <h3 class="co-card-title" style="margin:0;">Recent Releases</h3>
        <a href="/Releases" style="font-size:0.82rem;">View all →</a>
    </div>
    @if (Model.RecentReleases.Count == 0)
    {
        <p style="color:#6B7280;margin:0;font-size:0.9rem;">No releases yet.</p>
    }
    else
    {
        <div style="display:flex;flex-direction:column;gap:10px;">
            @foreach (var r in Model.RecentReleases)
            {
                var statusColor = r.StatusName switch
                {
                    "Planning" => "#6B7280",
                    "InDevelopment" => "#8B5CF6",
                    "InTesting" => "#F59E0B",
                    "Released" => "#16A34A",
                    "Cancelled" => "#9CA3AF",
                    _ => "#6B7280"
                };
                <a href="/Releases/Details/@r.Id" style="display:block;padding:14px 16px;border-radius:12px;background:var(--co-light);text-decoration:none;">
                    <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
                        <div style="min-width:0;">
                            <div style="font-family:monospace;font-size:0.75rem;color:var(--co-electric);font-weight:700;">@r.Version</div>
                            <div style="font-weight:600;color:var(--co-deep);font-size:0.9rem;">@r.Name</div>
                            <div style="font-size:0.72rem;color:#6B7280;margin-top:2px;">@r.Code · @r.FeatureCount feature@(r.FeatureCount == 1 ? "" : "s")</div>
                        </div>
                        <span class="badge" style="background:@(statusColor)22;color:@statusColor;flex-shrink:0;">@r.StatusName</span>
                    </div>
                </a>
            }
        </div>
    }
</div>