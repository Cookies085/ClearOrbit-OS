@model ClearOrbit.Web.ViewModels.ContactViewModel
@{
    ViewData["Title"] = "New Contact";
    Layout = "_Layout";
    var hasClientPreset = Model.ClientId != Guid.Empty;
}

<div class="co-card" style="max-width:640px;">

    @if (hasClientPreset)
    {
        <div style="background:var(--co-light);padding:16px 20px;border-radius:10px;margin-bottom:24px;">
            <div style="font-size:0.7rem;letter-spacing:2px;text-transform:uppercase;color:#6B7280;font-weight:600;margin-bottom:4px;">Adding contact to</div>
            <div style="font-size:1.05rem;font-weight:600;">@Model.ClientName</div>
        </div>
    }

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ClientId" />
        <input type="hidden" asp-for="ClientName" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        @if (!hasClientPreset)
        {
            <div class="form-group">
                <label asp-for="ClientId">Client *</label>
                <select asp-for="ClientId" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);">
                    <option value="">-- Select a client --</option>
                    @foreach (var c in Model.ClientOptions)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
                <span asp-validation-for="ClientId" class="field-error"></span>
            </div>
        }

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="form-group">
                <label asp-for="FirstName">First Name *</label>
                <input asp-for="FirstName" />
                <span asp-validation-for="FirstName" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName">Last Name *</label>
                <input asp-for="LastName" />
                <span asp-validation-for="LastName" class="field-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Email">Email *</label>
            <input asp-for="Email" type="email" placeholder="person@client.com" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="form-group">
                <label asp-for="Phone">Phone</label>
                <input asp-for="Phone" />
            </div>
            <div class="form-group">
                <label asp-for="JobTitle">Job Title</label>
                <input asp-for="JobTitle" placeholder="e.g., Marketing Manager" />
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Role">Role</label>
            <select asp-for="Role" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);">
                <option value="1">Primary</option>
                <option value="2">Decision Maker</option>
                <option value="3">Technical</option>
                <option value="4">Billing</option>
                <option value="99">Other</option>
            </select>
        </div>

        <div style="display:flex;gap:12px;margin-top:24px;">
            <button type="submit" class="btn-primary">Add Contact</button>
            <a href="@(hasClientPreset ? $"/Clients/Details/{Model.ClientId}" : "/Contacts")" class="btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}