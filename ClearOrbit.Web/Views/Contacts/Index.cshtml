@model List<ClearOrbit.Web.ViewModels.ContactListItem>
@{
    ViewData["Title"] = "Contacts";
    Layout = "_Layout";
}

@section TopbarActions {
    <a href="/Contacts/Create" class="btn-primary" style="padding:10px 22px;font-size:0.9rem;">+ Add Contact</a>
}

@if (TempData["Success"] is string success)
{
    <div style="background:#DCFCE7;border-left:4px solid #16A34A;color:#166534;padding:12px 16px;border-radius:8px;margin-bottom:20px;">@success</div>
}

<div class="co-card" style="padding:0;overflow:hidden;">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <h3>No contacts yet</h3>
            <p>Add the people we work with — a client, a principal, a marketing manager.</p>
            <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
                <a href="/Contacts/Create" class="btn-primary">Add First Contact</a>
                <a href="/Clients" class="btn-outline">View Clients</a>
            </div>
        </div>
    }
    else
    {
        <table class="co-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Client</th>
                    <th>Role</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Job Title</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    var roleColor = c.RoleName switch
                    {
                        "Primary" => "#1E90FF",
                        "DecisionMaker" => "#8B5CF6",
                        "Technical" => "#00B4D8",
                        "Billing" => "#F59E0B",
                        _ => "#6B7280"
                    };
                    var roleLabel = c.RoleName == "DecisionMaker" ? "Decision Maker" : c.RoleName;

                    <tr>
                        <td style="font-weight:600;">@c.FullName</td>
                        <td><a href="/Clients/Details/@c.ClientId">@c.ClientName</a></td>
                        <td><span class="badge" style="background:@(roleColor)22;color:@roleColor;">@roleLabel</span></td>
                        <td><a href="mailto:@c.Email">@c.Email</a></td>
                        <td>@(c.Phone ?? "—")</td>
                        <td>@(c.JobTitle ?? "—")</td>
                        <td style="text-align:right;">
                            <a href="/Contacts/Edit/@c.Id" style="font-size:0.85rem;">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>