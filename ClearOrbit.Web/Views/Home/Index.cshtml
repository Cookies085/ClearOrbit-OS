@{
    ViewData["Title"] = "Where Clarity Meets Innovation";
    Layout = "_LandingLayout";
}

<!-- =========================
     HERO
     ========================= -->
<section class="co-hero">
    <div class="co-orbit orbit-one"></div>
    <div class="co-orbit orbit-two"></div>

    <div class="co-hero-content">
        <div class="co-logo">
            <img src="~/img/logo-dark.png" alt="ClearOrbit Group" />
        </div>

        <div class="co-eyebrow">ClearOrbit Group</div>

        <h1>
            Where Clarity Meets
            <span>Innovation.</span>
        </h1>

        <p>
            We explore ideas, build solutions, develop people,
            and create meaningful impact.
        </p>

        <div class="co-hero-actions">
            <a href="#divisions" class="co-btn co-btn-primary">
                Explore ClearOrbit <span>→</span>
            </a>
            <a href="/Account/Login" class="co-btn co-btn-secondary">
                Enter ClearOrbit OS
            </a>
        </div>
    </div>

    <div class="co-scroll-indicator">
        <span></span>
        Scroll to explore
    </div>
</section>

<!-- =========================
     INTRODUCTION
     ========================= -->
<section class="co-introduction" id="philosophy">
    <div class="co-section-label">Our Orbit</div>

    <h2>
        One ecosystem.
        <span>Many directions.</span>
    </h2>

    <p>
        ClearOrbit brings education, technology, creativity,
        digital solutions and innovation together under one
        ecosystem — allowing ideas, people and possibilities
        to move further.
    </p>
</section>

<!-- =========================
     DIVISIONS
     ========================= -->
<section class="co-divisions" id="divisions">
    <div class="co-section-header">
        <div>
            <div class="co-section-label">The Group</div>
            <h2>Our Divisions</h2>
        </div>
        <p>Different disciplines. One ClearOrbit.</p>
    </div>

    <div class="co-division-list">

        <a href="#" class="co-division academy">
            <span class="division-number">01</span>
            <div class="division-content">
                <span class="division-name">Academy</span>
                <span class="division-description">Education &amp; Skills</span>
            </div>
            <span class="division-arrow">↗</span>
        </a>

        <a href="#" class="co-division software">
            <span class="division-number">02</span>
            <div class="division-content">
                <span class="division-name">Software</span>
                <span class="division-description">Technology &amp; Systems</span>
            </div>
            <span class="division-arrow">↗</span>
        </a>

        <a href="#" class="co-division games">
            <span class="division-number">03</span>
            <div class="division-content">
                <span class="division-name">Games</span>
                <span class="division-description">Interactive Experiences</span>
            </div>
            <span class="division-arrow">↗</span>
        </a>

        <a href="#" class="co-division designs">
            <span class="division-number">04</span>
            <div class="division-content">
                <span class="division-name">Designs</span>
                <span class="division-description">Creative Direction</span>
            </div>
            <span class="division-arrow">↗</span>
        </a>

        <a href="#" class="co-division innovation">
            <span class="division-number">05</span>
            <div class="division-content">
                <span class="division-name">Innovation Lab</span>
                <span class="division-description">Research &amp; Emerging Technology</span>
            </div>
            <span class="division-arrow">↗</span>
        </a>

        <a href="#" class="co-division digital">
            <span class="division-number">06</span>
            <div class="division-content">
                <span class="division-name">Digital Solutions</span>
                <span class="division-description">Digital Transformation</span>
            </div>
            <span class="division-arrow">↗</span>
        </a>

        <a href="#" class="co-division mediaworks">
            <span class="division-number">07</span>
            <div class="division-content">
                <span class="division-name">MediaWorks</span>
                <span class="division-description">Media &amp; Content</span>
            </div>
            <span class="division-arrow">↗</span>
        </a>

        <a href="#" class="co-division training">
            <span class="division-number">08</span>
            <div class="division-content">
                <span class="division-name">Training &amp; Certification</span>
                <span class="division-description">Professional Development</span>
            </div>
            <span class="division-arrow">↗</span>
        </a>

    </div>
</section>

<!-- =========================
     VALUES
     ========================= -->
<section class="co-values">
    <div class="co-section-label">Our Philosophy</div>

    <h2>
        Built around three
        <span>principles.</span>
    </h2>

    <div class="co-value-grid">
        <div>
            <span>01</span>
            <h3>Clarity</h3>
            <p>We simplify complexity and make ideas easier to understand.</p>
        </div>
        <div>
            <span>02</span>
            <h3>Innovation</h3>
            <p>We explore new possibilities and build better ways forward.</p>
        </div>
        <div>
            <span>03</span>
            <h3>Impact</h3>
            <p>We create work that has meaningful value for people and communities.</p>
        </div>
    </div>
</section>

<!-- =========================
     COMMUNITY
     ========================= -->
<section class="co-community" id="community">
    <div class="co-community-inner">
        <div class="co-section-label">Beyond Business</div>

        <h2>
            Innovation should
            <span>reach people.</span>
        </h2>

        <p>
            ClearOrbit exists not only to build businesses, products
            and technology, but to create opportunities, share knowledge,
            and contribute meaningfully to the communities around us.
        </p>

        <a href="mailto:hello@clearorbit.co.za" class="co-text-link">
            Discover our impact →
        </a>
    </div>
</section>

<!-- =========================
     FINAL CTA
     ========================= -->
<section class="co-final">
    <div class="co-final-orbit"></div>

    <div class="co-final-content">
        <div class="co-section-label">The Orbit Is Open</div>

        <h2>
            Explore an idea.<br />
            Build something meaningful.<br />
            <span>Move forward.</span>
        </h2>

        <div class="co-hero-actions">
            <a href="#divisions" class="co-btn co-btn-primary">
                Explore ClearOrbit <span>→</span>
            </a>
            <a href="mailto:hello@clearorbit.co.za" class="co-btn co-btn-secondary">
                Get in Touch
            </a>
        </div>
    </div>
</section>