@model ClearOrbit.Web.ViewModels.TaskViewModel
@{
    ViewData["Title"] = "Edit Task";
    Layout = "_Layout";
}

<div class="co-card" style="max-width:720px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Title">Task Title *</label>
            <input asp-for="Title" />
            <span asp-validation-for="Title" class="field-error"></span>
        </div>

        <div class="form-group">
            <label>Project</label>
            <input type="text" value="@Model.ProjectCode — @Model.ProjectName" disabled style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-100);color:#6B7280;" />
            <input type="hidden" asp-for="ProjectId" />
        </div>

        <div class="form-group">
            <label asp-for="Status">Status</label>
            <select asp-for="Status" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);">
                <option value="1">To Do</option>
                <option value="2">In Progress</option>
                <option value="3">Blocked</option>
                <option value="4">In Review</option>
                <option value="5">Done</option>
                <option value="6">Cancelled</option>
            </select>
        </div>

        <div class="form-group">
            <label asp-for="Priority">Priority</label>
            <select asp-for="Priority" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);">
                <option value="1">Low</option>
                <option value="2">Normal</option>
                <option value="3">High</option>
                <option value="4">Urgent</option>
            </select>
        </div>

        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" rows="3" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);"></textarea>
        </div>

        <div class="form-group">
            <label asp-for="DueDate">Due Date</label>
            <input asp-for="DueDate" type="date" />
        </div>

        <div style="display:flex;gap:12px;margin-top:24px;">
            <button type="submit" class="btn-primary">Save Changes</button>
            <a href="/Tasks" class="btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }