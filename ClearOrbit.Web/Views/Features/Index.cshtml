@model List<ClearOrbit.Web.ViewModels.FeatureListItem>
@{
    ViewData["Title"] = "Features";
    Layout = "_Layout";
}

@section TopbarActions {
    <a href="/Features/Create" class="btn-primary" style="padding:10px 22px;font-size:0.9rem;">+ New Feature</a>
}

@if (TempData["Success"] is string success)
{
    <div style="background:#DCFCE7;border-left:4px solid #16A34A;color:#166534;padding:12px 16px;border-radius:8px;margin-bottom:20px;">@success</div>
}

<div class="co-card" style="padding:0;overflow:hidden;">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <h3>No features yet</h3>
            <p>Track what you're building across every division.</p>
            <a href="/Features/Create" class="btn-primary">Create First Feature</a>
        </div>
    }
    else
    {
        <table class="co-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Feature</th>
                    <th>Division</th>
                    <th>Client</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Target</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    var statusColor = f.StatusName switch
                    {
                        "Proposed" => "#6B7280",
                        "Approved" => "#3B82F6",
                        "InProgress" => "#8B5CF6",
                        "Testing" => "#F59E0B",
                        "Shipped" => "#16A34A",
                        "Rejected" => "#9CA3AF",
                        _ => "#6B7280"
                    };
                    var priorityColor = f.PriorityName switch
                    {
                        "Low" => "#9CA3AF",
                        "Normal" => "#3B82F6",
                        "High" => "#F59E0B",
                        "Critical" => "#DC2626",
                        _ => "#6B7280"
                    };

                    <tr>
                        <td style="font-family:monospace;font-size:0.78rem;color:#6B7280;">@f.Code</td>
                        <td>
                            <a href="/Features/Details/@f.Id" style="font-weight:600;color:var(--co-deep);">@f.Title</a>
                            @if (!string.IsNullOrWhiteSpace(f.ProjectCode))
                            {
                                <div style="font-size:0.72rem;color:#6B7280;">for @f.ProjectCode</div>
                            }
                        </td>
                        <td>
                            <span class="badge" style="background:@(f.DivisionAccent)22;color:@f.DivisionAccent;">@f.DivisionName</span>
                        </td>
                        <td>@(f.ClientName ?? "—")</td>
                        <td><span class="badge" style="background:@(priorityColor)22;color:@priorityColor;">@f.PriorityName</span></td>
                        <td><span class="badge" style="background:@(statusColor)22;color:@statusColor;">@f.StatusName</span></td>
                        <td>@(f.TargetDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td style="text-align:right;white-space:nowrap;">
                            <a href="/Features/Details/@f.Id" style="font-size:0.85rem;">View</a>
                            <span style="color:#E5E7EB;margin:0 8px;">·</span>
                            <a href="/Features/Edit/@f.Id" style="font-size:0.85rem;">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>