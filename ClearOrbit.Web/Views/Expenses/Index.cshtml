@model List<ClearOrbit.Web.ViewModels.ExpenseListItem>
@{
    ViewData["Title"] = "Expenses";
    Layout = "_Layout";
    var total = Model.Sum(e => e.Amount);
    var currency = Model.FirstOrDefault()?.Currency ?? "ZAR";
}

@section TopbarActions {
    <a href="/Expenses/Create" class="btn-primary" style="padding:10px 22px;font-size:0.9rem;">+ New Expense</a>
}

@if (TempData["Success"] is string success)
{
    <div style="background:#DCFCE7;border-left:4px solid #16A34A;color:#166534;padding:12px 16px;border-radius:8px;margin-bottom:20px;">
        @success
    </div>
}

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;margin-bottom:24px;">
    <div class="co-card" style="margin:0;">
        <div style="font-size:0.7rem;letter-spacing:2px;text-transform:uppercase;color:#6B7280;margin-bottom:10px;font-weight:600;">Total Expenses</div>
        <div style="font-size:2rem;font-weight:700;color:#DC2626;letter-spacing:-1px;">@currency @total.ToString("N2")</div>
    </div>
    <div class="co-card" style="margin:0;">
        <div style="font-size:0.7rem;letter-spacing:2px;text-transform:uppercase;color:#6B7280;margin-bottom:10px;font-weight:600;">Entries</div>
        <div style="font-size:2rem;font-weight:700;color:var(--co-deep);letter-spacing:-1px;">@Model.Count</div>
    </div>
</div>

<div class="co-card" style="padding:0;overflow:hidden;">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <h3>No expenses recorded</h3>
            <p>Every cost you track brings ClearOrbit closer to real profitability reporting.</p>
            <a href="/Expenses/Create" class="btn-primary">Record Expense</a>
        </div>
    }
    else
    {
        <table class="co-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th>Project</th>
                    <th>Division</th>
                    <th>Date</th>
                    <th style="text-align:right;">Amount</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td style="font-family:monospace;font-size:0.8rem;font-weight:600;">@e.Code</td>
                        <td>
                            <div style="font-weight:600;">@e.Description</div>
                            @if (!string.IsNullOrWhiteSpace(e.Vendor))
                            {
                                <div style="font-size:0.75rem;color:#6B7280;">@e.Vendor</div>
                            }
                        </td>
                        <td><span class="badge badge-blue">@e.CategoryName</span></td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(e.ProjectCode))
                            {
                                <div style="font-family:monospace;font-size:0.72rem;color:#6B7280;">@e.ProjectCode</div>
                            }
                            else
                            {
                                <span style="color:#9CA3AF;">—</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(e.DivisionName))
                            {
                                <span class="badge" style="background:@(e.DivisionAccent)22;color:@e.DivisionAccent;">
                                    @e.DivisionName
                                </span>
                            }
                            else
                            {
                                <span style="color:#9CA3AF;">—</span>
                            }
                        </td>
                        <td>@e.ExpenseDate.ToString("yyyy-MM-dd")</td>
                        <td style="text-align:right;font-weight:600;color:#DC2626;">@e.Currency @e.Amount.ToString("N2")</td>
                        <td style="text-align:right;">
                            <a href="/Expenses/Edit/@e.Id" style="font-size:0.85rem;">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>