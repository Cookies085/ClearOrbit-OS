@model ClearOrbit.Web.ViewModels.AcademyWorkspaceViewModel
@{
    ViewData["Title"] = "Academy";
    Layout = "_Layout";
}

<div class="hero-card" style="background: linear-gradient(135deg, #05122A 0%, #0A2A5C 60%, #1E90FF 200%);">
    <div class="hero-card-inner">
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:12px;">
            <div style="width:56px;height:56px;border-radius:16px;background:#1E90FF;display:flex;align-items:center;justify-content:center;font-size:1.6rem;box-shadow:0 8px 24px rgba(30,144,255,0.4);">🎓</div>
            <div>
                <div style="font-size:0.72rem;letter-spacing:4px;color:rgba(255,255,255,0.5);text-transform:uppercase;font-weight:700;">ClearOrbit</div>
                <h2 style="font-size:1.75rem;font-weight:700;margin:2px 0 0;letter-spacing:-0.5px;color:#fff;">Academy</h2>
            </div>
        </div>
        <p style="color:rgba(255,255,255,0.75);margin:12px 0 0;max-width:600px;font-size:0.95rem;">
            Explore Knowledge. Build the Future.
        </p>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:24px;margin-top:28px;padding-top:24px;border-top:1px solid rgba(255,255,255,0.1);">
            <div>
                <div style="font-size:0.65rem;letter-spacing:2px;color:rgba(255,255,255,0.5);text-transform:uppercase;margin-bottom:6px;">Learners</div>
                <div style="font-size:1.75rem;font-weight:700;color:#fff;letter-spacing:-1px;">@Model.LearnerCount</div>
            </div>
            <div>
                <div style="font-size:0.65rem;letter-spacing:2px;color:rgba(255,255,255,0.5);text-transform:uppercase;margin-bottom:6px;">Tutors</div>
                <div style="font-size:1.75rem;font-weight:700;color:#fff;letter-spacing:-1px;">@Model.TutorCount</div>
            </div>
            <div>
                <div style="font-size:0.65rem;letter-spacing:2px;color:rgba(255,255,255,0.5);text-transform:uppercase;margin-bottom:6px;">Classes</div>
                <div style="font-size:1.75rem;font-weight:700;color:#fff;letter-spacing:-1px;">@Model.ClassCount</div>
            </div>
            <div>
                <div style="font-size:0.65rem;letter-spacing:2px;color:rgba(255,255,255,0.5);text-transform:uppercase;margin-bottom:6px;">Attendance</div>
                <div style="font-size:1.75rem;font-weight:700;color:rgba(255,255,255,0.4);letter-spacing:-1px;">@Model.SessionCount</div>
            </div>
        </div>
    </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;margin-bottom:24px;">
    <a href="/Learners" style="text-decoration:none;">
        <div class="stat-card" style="cursor:pointer;">
            <div class="stat-label">Learners</div>
            <div class="stat-value" style="color:var(--co-deep);">@Model.LearnerCount</div>
            <div class="stat-sub">Manage enrollments →</div>
        </div>
    </a>
    <a href="/Tutors" style="text-decoration:none;">
        <div class="stat-card" style="cursor:pointer;">
            <div class="stat-label">Tutors</div>
            <div class="stat-value" style="color:var(--co-deep);">@Model.TutorCount</div>
            <div class="stat-sub">Manage instructors →</div>
        </div>
    </a>
    <a href="/Classes" style="text-decoration:none;">
        <div class="stat-card" style="cursor:pointer;">
            <div class="stat-label">Classes</div>
            <div class="stat-value" style="color:var(--co-deep);">@Model.ClassCount</div>
            <div class="stat-sub">@Model.TotalEnrollments enrollments →</div>
        </div>
    </a>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">
    <div class="co-card" style="margin:0;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <h3 class="co-card-title" style="margin:0;">Recent Learners</h3>
            <a href="/Learners" style="font-size:0.82rem;">View all →</a>
        </div>
        @if (Model.RecentLearners.Count == 0)
        {
            <div style="text-align:center;padding:24px 0;color:#9CA3AF;">
                <p style="margin:0 0 16px;">No learners yet.</p>
                <a href="/Learners/Create" class="btn-primary">Enroll first learner</a>
            </div>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:10px;">
                @foreach (var l in Model.RecentLearners)
                {
                    <a href="/Learners/Edit/@l.Id" style="display:block;padding:12px 14px;border-radius:10px;background:var(--co-light);text-decoration:none;">
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <div>
                                <div style="font-weight:600;color:var(--co-deep);font-size:0.9rem;">@l.FullName</div>
                                <div style="font-size:0.75rem;color:#6B7280;">@l.GradeLevelName · @l.Code</div>
                            </div>
                            <span class="badge badge-blue">@l.StatusName</span>
                        </div>
                    </a>
                }
            </div>
        }
    </div>

    <div class="co-card" style="margin:0;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <h3 class="co-card-title" style="margin:0;">Recent Tutors</h3>
            <a href="/Tutors" style="font-size:0.82rem;">View all →</a>
        </div>
        @if (Model.RecentTutors.Count == 0)
        {
            <div style="text-align:center;padding:24px 0;color:#9CA3AF;">
                <p style="margin:0 0 16px;">No tutors yet.</p>
                <a href="/Tutors/Create" class="btn-primary">Add first tutor</a>
            </div>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:10px;">
                @foreach (var t in Model.RecentTutors)
                {
                    <a href="/Tutors/Edit/@t.Id" style="display:block;padding:12px 14px;border-radius:10px;background:var(--co-light);text-decoration:none;">
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <div>
                                <div style="font-weight:600;color:var(--co-deep);font-size:0.9rem;">@t.FullName</div>
                                <div style="font-size:0.75rem;color:#6B7280;">@t.Specializations</div>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>