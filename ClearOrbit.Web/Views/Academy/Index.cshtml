@model ClearOrbit.Web.ViewModels.AcademyWorkspaceViewModel
@{
    ViewData["Title"] = "Academy";
    Layout = "_Layout";
}

<div class="division-hero" style="--hero-accent: #1E90FF; --hero-accent-soft: rgba(30, 144, 255, 0.28); --hero-accent-glow: rgba(30, 144, 255, 0.5);">
    <div class="division-hero-inner">

        <div class="division-hero-header">
            <div class="division-hero-icon">🎓</div>
            <div>
                <div class="division-hero-eyebrow">ClearOrbit</div>
                <h2 class="division-hero-title">Academy</h2>
            </div>
        </div>

        <p class="division-hero-tagline">
            Explore Knowledge. Build the Future.
        </p>

        <div class="division-hero-stats">
            <div>
                <div class="division-hero-stat-label">Learners</div>
                <div class="division-hero-stat-value">@Model.LearnerCount</div>
            </div>
            <div>
                <div class="division-hero-stat-label">Tutors</div>
                <div class="division-hero-stat-value">@Model.TutorCount</div>
            </div>
            <div>
                <div class="division-hero-stat-label">Classes</div>
                <div class="division-hero-stat-value">@Model.ClassCount</div>
            </div>
            <div>
                <div class="division-hero-stat-label">Sessions</div>
                <div class="division-hero-stat-value">@Model.SessionCount</div>
            </div>
        </div>

    </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;margin-bottom:24px;">
    <a href="/Learners" style="text-decoration:none;">
        <div class="stat-card" style="cursor:pointer;">
            <div class="stat-label">Learners</div>
            <div class="stat-value" style="color:var(--co-deep);">@Model.LearnerCount</div>
            <div class="stat-sub">Manage enrollments →</div>
        </div>
    </a>
    <a href="/Tutors" style="text-decoration:none;">
        <div class="stat-card" style="cursor:pointer;">
            <div class="stat-label">Tutors</div>
            <div class="stat-value" style="color:var(--co-deep);">@Model.TutorCount</div>
            <div class="stat-sub">Manage instructors →</div>
        </div>
    </a>
    <a href="/Classes" style="text-decoration:none;">
        <div class="stat-card" style="cursor:pointer;">
            <div class="stat-label">Classes</div>
            <div class="stat-value" style="color:var(--co-deep);">@Model.ClassCount</div>
            <div class="stat-sub">@Model.TotalEnrollments enrollments →</div>
        </div>
    </a>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">
    <div class="co-card" style="margin:0;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <h3 class="co-card-title" style="margin:0;">Recent Learners</h3>
            <a href="/Learners" style="font-size:0.82rem;">View all →</a>
        </div>
        @if (Model.RecentLearners.Count == 0)
        {
            <div style="text-align:center;padding:24px 0;color:#9CA3AF;">
                <p style="margin:0 0 16px;">No learners yet.</p>
                <a href="/Learners/Create" class="btn-primary">Enroll first learner</a>
            </div>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:10px;">
                @foreach (var l in Model.RecentLearners)
                {
                    <a href="/Learners/Edit/@l.Id" style="display:block;padding:12px 14px;border-radius:10px;background:var(--co-light);text-decoration:none;">
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <div>
                                <div style="font-weight:600;color:var(--co-deep);font-size:0.9rem;">@l.FullName</div>
                                <div style="font-size:0.75rem;color:#6B7280;">@l.GradeLevelName · @l.Code</div>
                            </div>
                            <span class="badge badge-blue">@l.StatusName</span>
                        </div>
                    </a>
                }
            </div>
        }
    </div>

    <div class="co-card" style="margin:0;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
            <h3 class="co-card-title" style="margin:0;">Recent Tutors</h3>
            <a href="/Tutors" style="font-size:0.82rem;">View all →</a>
        </div>
        @if (Model.RecentTutors.Count == 0)
        {
            <div style="text-align:center;padding:24px 0;color:#9CA3AF;">
                <p style="margin:0 0 16px;">No tutors yet.</p>
                <a href="/Tutors/Create" class="btn-primary">Add first tutor</a>
            </div>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:10px;">
                @foreach (var t in Model.RecentTutors)
                {
                    <a href="/Tutors/Edit/@t.Id" style="display:block;padding:12px 14px;border-radius:10px;background:var(--co-light);text-decoration:none;">
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <div>
                                <div style="font-weight:600;color:var(--co-deep);font-size:0.9rem;">@t.FullName</div>
                                <div style="font-size:0.75rem;color:#6B7280;">@t.Specializations</div>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>