@model ClearOrbit.Web.ViewModels.ProjectViewModel
@{
    ViewData["Title"] = "New Project";
    Layout = "_Layout";
}

<div class="co-card" style="max-width:720px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Name">Project Name *</label>
            <input asp-for="Name" placeholder="e.g., ABC School Website Redesign" />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Type">Project Type *</label>
            <select asp-for="Type" id="typeSelect" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);">
                <option value="1">External (for a client)</option>
                <option value="2">Internal (inter-division request)</option>
            </select>
        </div>

        <div class="form-group" id="clientGroup">
            <label asp-for="ClientId">Client *</label>
            <select asp-for="ClientId" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);">
                <option value="">-- Select a client --</option>
                @foreach (var c in Model.Clients)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>

        <div class="form-group" id="requestingDivisionGroup" style="display:none;">
            <label asp-for="RequestingDivisionId">Requesting Division *</label>
            <select asp-for="RequestingDivisionId" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);">
                <option value="">-- Which division is requesting? --</option>
                @foreach (var d in Model.Divisions)
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label asp-for="DivisionId">Delivering Division *</label>
            <select asp-for="DivisionId" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);">
                <option value="">-- Which division will deliver? --</option>
                @foreach (var d in Model.Divisions)
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </select>
            <span asp-validation-for="DivisionId" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="ServiceId">Service (optional)</label>
            <select asp-for="ServiceId" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);">
                <option value="">-- None --</option>
                @foreach (var s in Model.Services)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
        </div>

        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" rows="3" style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);"></textarea>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;">
            <div class="form-group">
                <label asp-for="Budget">Budget</label>
                <input asp-for="Budget" type="number" step="0.01" />
            </div>
            <div class="form-group">
                <label asp-for="Currency">Currency</label>
                <input asp-for="Currency" />
            </div>
            <div class="form-group">
                <label asp-for="StartDate">Start Date</label>
                <input asp-for="StartDate" type="date" />
            </div>
        </div>

        <div class="form-group">
            <label asp-for="DueDate">Due Date</label>
            <input asp-for="DueDate" type="date" />
        </div>

        <div style="display:flex;gap:12px;margin-top:24px;">
            <button type="submit" class="btn-primary">Create Project</button>
            <a href="/Projects" class="btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const typeSelect = document.getElementById('typeSelect');
            const clientGroup = document.getElementById('clientGroup');
            const requestingGroup = document.getElementById('requestingDivisionGroup');
            function refresh() {
                const isInternal = typeSelect.value === '2';
                clientGroup.style.display = isInternal ? 'none' : '';
                requestingGroup.style.display = isInternal ? '' : 'none';
            }
            typeSelect.addEventListener('change', refresh);
            refresh();
        })();
    </script>
}