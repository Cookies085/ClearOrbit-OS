@model List<ClearOrbit.Web.ViewModels.ProjectListItem>
@{
    ViewData["Title"] = "Projects";
    Layout = "_Layout";
}

@section TopbarActions {
    <a href="/Projects/Create" class="btn-primary" style="padding:10px 22px;font-size:0.9rem;">+ New Project</a>
}

@if (TempData["Success"] is string success)
{
    <div style="background:#DCFCE7;border-left:4px solid #16A34A;color:#166534;padding:12px 16px;border-radius:8px;margin-bottom:20px;">
        @success
    </div>
}

<div class="co-card" style="padding:0;overflow:hidden;">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <h3>No projects yet</h3>
            <p>Every piece of work at ClearOrbit starts as a project.</p>
            <a href="/Projects/Create" class="btn-primary">Create Project</a>
        </div>
    }
    else
    {
        <table class="co-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Project</th>
                    <th>Client / Source</th>
                    <th>Division</th>
                    <th>Status</th>
                    <th>Due</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td style="font-family:monospace;font-size:0.8rem;color:#6B7280;">@p.Code</td>
                        <td>
                            <a href="/Projects/Details/@p.Id style="font-weight:600;color:var(--co-deep);">@p.Name</a>
                            @if (p.TypeName == "Internal")
                            {
                                <span style="font-size:0.7rem;color:#8B5CF6;font-weight:500;">INTERNAL</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(p.ClientName))
                            {
                                @p.ClientName
                            }
                            else if (!string.IsNullOrWhiteSpace(p.RequestingDivisionName))
                            {
                                <span style="color:#6B7280;">from @p.RequestingDivisionName</span>
                            }
                            else
                            {
                                <span style="color:#9CA3AF;">—</span>
                            }
                        </td>
                        <td>
                            <span class="badge" style="background:@(p.DivisionAccent)22;color:@p.DivisionAccent;">
                                @p.DivisionName
                            </span>
                        </td>
                        <td>
                            @{
                                var badgeColor = p.StatusName switch
                                {
                                    "Draft" => "#6B7280",
                                    "Active" => "#16A34A",
                                    "OnHold" => "#F59E0B",
                                    "Completed" => "#1E90FF",
                                    "Cancelled" => "#DC2626",
                                    _ => "#6B7280"
                                };
                            }
                            <span class="badge" style="background:@(badgeColor)22;color:@badgeColor;">@p.StatusName</span>
                        </td>
                        <td>@(p.DueDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td style="text-align:right;white-space:nowrap;">
                            <a href="/Projects/Details/@p.Id" style="font-size:0.85rem;">View</a>
                            <span style="color:#E5E7EB;margin:0 8px;">·</span>
                            <a href="/Projects/Edit/@p.Id" style="font-size:0.85rem;">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>