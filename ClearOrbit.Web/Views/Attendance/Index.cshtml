@model List<ClearOrbit.Web.ViewModels.AttendanceHubRow>
@{
    ViewData["Title"] = "Attendance";
    Layout = "_Layout";
}

@if (TempData["Success"] is string success)
{
    <div style="background:#DCFCE7;border-left:4px solid #16A34A;color:#166534;padding:12px 16px;border-radius:8px;margin-bottom:20px;">@success</div>
}

@if (Model.Count == 0)
{
    <div class="co-card">
        <div class="empty-state">
            <h3>No classes yet</h3>
            <p>Create a class first, then you can record attendance for each session.</p>
            <a href="/Classes/Create" class="btn-primary">Create Class</a>
        </div>
    </div>
}
else
{
    <div class="co-card" style="padding:0;overflow:hidden;">
        <table class="co-table">
            <thead>
                <tr>
                    <th>Class</th>
                    <th>Schedule</th>
                    <th>Tutor</th>
                    <th style="text-align:center;">Enrolled</th>
                    <th style="text-align:center;">Sessions</th>
                    <th style="text-align:center;">Attendance Rate</th>
                    <th>Last Session</th>
                    <th style="text-align:right;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    var rateColor = c.AttendanceRate >= 80 ? "#16A34A"
                    : c.AttendanceRate >= 60 ? "#F59E0B"
                    : c.SessionCount == 0 ? "#9CA3AF"
                    : "#DC2626";

                    <tr>
                        <td>
                            <a href="/Classes/Details/@c.ClassId" style="font-weight:600;color:var(--co-deep);">@c.ClassName</a>
                            <div style="font-family:monospace;font-size:0.72rem;color:#6B7280;">@c.ClassCode · @c.Subject</div>
                        </td>
                        <td>
                            <div style="font-size:0.85rem;font-weight:500;">@c.DayOfWeekName</div>
                            <div style="font-size:0.78rem;color:#6B7280;">@c.StartTime</div>
                        </td>
                        <td>@c.TutorName</td>
                        <td style="text-align:center;font-weight:600;">@c.EnrolledCount</td>
                        <td style="text-align:center;font-weight:600;">@c.SessionCount</td>
                        <td style="text-align:center;">
                            @if (c.SessionCount == 0)
                            {
                                <span style="color:#9CA3AF;">—</span>
                            }
                            else
                            {
                                <span style="font-weight:700;color:@rateColor;">@c.AttendanceRate.ToString("F1")%</span>
                            }
                        </td>
                        <td>
                            @if (c.LastSessionDate.HasValue)
                            {
                                @c.LastSessionDate.Value.ToString("dd MMM yyyy")
                            }
                            else
                            {
                                <span style="color:#9CA3AF;">—</span>
                            }
                        </td>
                        <td style="text-align:right;">
                            <a href="/Attendance/Take?classId=@c.ClassId" style="font-size:0.82rem;">Take Attendance</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}