@model ClearOrbit.Web.ViewModels.ClassListItem
@{
    ViewData["Title"] = Model.Code;
    Layout = "_Layout";
    var enrollments = ViewData["Enrollments"] as List<ClearOrbit.Web.ViewModels.EnrollmentListItem> ?? new();
    var allLearners = ViewData["AllLearners"] as List<ClearOrbit.Web.ViewModels.LearnerListItem> ?? new();
    var enrolledIds = enrollments.Where(e => e.StatusName == "Active").Select(e => e.LearnerId).ToHashSet();
    var availableLearners = allLearners.Where(l => !enrolledIds.Contains(l.Id)).ToList();
    var isFull = Model.EnrolledCount >= Model.MaxCapacity;
}

@section TopbarActions {
    <a href="/Classes/Edit/@Model.Id" class="btn-outline" style="padding:10px 22px;font-size:0.9rem;">Edit Class</a>
}

@if (TempData["Success"] is string success)
{
    <div style="background:#DCFCE7;border-left:4px solid #16A34A;color:#166534;padding:12px 16px;border-radius:8px;margin-bottom:20px;">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div style="background:#FEE2E2;border-left:4px solid #DC2626;color:#991B1B;padding:12px 16px;border-radius:8px;margin-bottom:20px;">@error</div>
}

<div class="co-card">
    <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:24px;">
        <div>
            <div style="font-family:monospace;font-size:1.25rem;font-weight:700;color:var(--co-deep);">@Model.Code</div>
            <h2 style="margin:6px 0 4px;font-size:1.5rem;">@Model.Name</h2>
            <div style="color:#6B7280;font-size:0.9rem;">@Model.Subject · @Model.GradeLevelName</div>
        </div>
        @{
            var statusColor = Model.StatusName switch
            {
                "Draft" => "#6B7280",
                "Active" => "#16A34A",
                "Completed" => "#1E90FF",
                "Cancelled" => "#9CA3AF",
                _ => "#6B7280"
            };
        }
        <span class="badge" style="background:@(statusColor)22;color:@statusColor;font-size:0.85rem;padding:6px 16px;">@Model.StatusName</span>
    </div>

    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:24px;padding:20px 0;border-top:1px solid #E5E7EB;border-bottom:1px solid #E5E7EB;">
        <div>
            <div style="font-size:0.7rem;letter-spacing:2px;color:#6B7280;font-weight:600;margin-bottom:6px;">TUTOR</div>
            <div style="font-weight:600;">@Model.TutorName</div>
        </div>
        <div>
            <div style="font-size:0.7rem;letter-spacing:2px;color:#6B7280;font-weight:600;margin-bottom:6px;">SCHEDULE</div>
            <div style="font-weight:600;">@Model.DayOfWeekName</div>
            <div style="font-size:0.8rem;color:#6B7280;">@Model.StartTime – @Model.EndTime</div>
        </div>
        <div>
            <div style="font-size:0.7rem;letter-spacing:2px;color:#6B7280;font-weight:600;margin-bottom:6px;">LOCATION</div>
            <div style="font-weight:600;">@(Model.Location ?? "—")</div>
        </div>
        <div>
            <div style="font-size:0.7rem;letter-spacing:2px;color:#6B7280;font-weight:600;margin-bottom:6px;">CAPACITY</div>
            <div style="font-weight:600;">@Model.EnrolledCount / @Model.MaxCapacity</div>
            <div style="font-size:0.8rem;color:#6B7280;">@Model.AvailableSeats seats left</div>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:24px;">
        <div>
            <div style="font-size:0.7rem;letter-spacing:2px;color:#6B7280;font-weight:600;margin-bottom:6px;">START DATE</div>
            <div>@Model.StartDate.ToString("dd MMM yyyy")</div>
        </div>
        <div>
            <div style="font-size:0.7rem;letter-spacing:2px;color:#6B7280;font-weight:600;margin-bottom:6px;">FEE PER LEARNER</div>
            <div style="font-weight:600;">@Model.Currency @Model.FeePerLearner.ToString("N2")</div>
        </div>
    </div>
</div>

<div class="co-card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <h3 class="co-card-title" style="margin:0;">Enrolled Learners (@enrollments.Count(e => e.StatusName == "Active"))</h3>
    </div>

    @if (enrollments.Count == 0)
    {
        <p style="color:#6B7280;margin:0 0 20px;font-size:0.9rem;">No learners enrolled yet.</p>
    }
    else
    {
        <table class="co-table" style="margin-bottom:20px;">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Enrolled</th>
                    <th>Status</th>
                    <th style="text-align:right;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in enrollments)
                {
                    var color = e.StatusName switch
                    {
                        "Active" => "#16A34A",
                        "Completed" => "#1E90FF",
                        "Withdrawn" => "#9CA3AF",
                        _ => "#6B7280"
                    };
                    <tr>
                        <td style="font-family:monospace;font-size:0.78rem;color:#6B7280;">@e.LearnerCode</td>
                        <td style="font-weight:600;">@e.LearnerName</td>
                        <td style="font-size:0.85rem;">@(e.LearnerEmail ?? "—")</td>
                        <td>@e.EnrolledOn.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge" style="background:@(color)22;color:@color;">@e.StatusName</span></td>
                        <td style="text-align:right;">
                            @if (e.StatusName == "Active")
                            {
                                <form asp-action="Withdraw" method="post" style="display:inline;margin:0;" onsubmit="return confirm('Withdraw this learner?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="enrollmentId" value="@e.Id" />
                                    <input type="hidden" name="classId" value="@Model.Id" />
                                    <button type="submit" style="background:none;border:none;color:#DC2626;font-size:0.8rem;cursor:pointer;">Withdraw</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h4 style="margin:24px 0 12px;font-size:0.9rem;color:var(--co-deep);">Enroll a Learner</h4>

    @if (isFull)
    {
        <div style="background:#FEF3C7;border-left:4px solid #F59E0B;color:#92400E;padding:12px 16px;border-radius:8px;font-size:0.85rem;">
            This class is full (@Model.EnrolledCount / @Model.MaxCapacity).
        </div>
    }
    else if (availableLearners.Count == 0)
    {
        <p style="color:#6B7280;font-size:0.85rem;">All learners are already enrolled. <a href="/Learners/Create">Enroll a new learner →</a></p>
    }
    else
    {
        <form asp-action="Enroll" method="post" style="display:flex;gap:12px;align-items:end;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="classId" value="@Model.Id" />
            <div style="flex:1;">
                <label style="display:block;font-size:0.8rem;font-weight:600;color:var(--co-gray-700);margin-bottom:8px;">Select Learner</label>
                <select name="learnerId" required style="width:100%;padding:13px 16px;border:1.5px solid #E5E7EB;border-radius:10px;font-family:var(--co-font);font-size:0.95rem;background:var(--co-gray-50);">
                    <option value="">-- Choose a learner --</option>
                    @foreach (var l in availableLearners)
                    {
                        <option value="@l.Id">@l.FullName (@l.Code) — @l.GradeLevelName</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn-primary">Enroll</button>
        </form>
    }
</div>

<a href="/Classes" style="font-size:0.9rem;">← Back to Classes</a>